{
  "name": "stock-insights-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Multi-agent stock insights workflow built with Node.js and LangGraph.",
  "main": "src/server.ts",
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "cli": "tsx src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "eval": "tsx eval/runEvals.ts",
    "eval:scenario": "tsx eval/runEvals.ts",
    "check": "npm run typecheck && node --check eval/scenarios.js && node --check eval/assertions.js"
  },
  "dependencies": {
    "@langchain/core": "^0.3.68",
    "@langchain/langgraph": "^0.2.53",
    "@langchain/openai": "^0.3.13",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "finnhub": "^2.0.15",
    "nodemailer": "^10.0.13"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2"
  }
}
