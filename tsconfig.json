{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": ["node"]
  },
  "include": [
    "src/config.js",
    "src/lib/**/*.js",
    "src/lib/**/*.ts",
    "src/agents/**/*.js",
    "src/agents/**/*.ts",
    "src/workflow/**/*.js",
    "src/workflow/**/*.ts",
    "src/server.ts",
    "src/index.ts",
    "eval/runEvals.ts",
    "src/types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
