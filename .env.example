OPENAI_API_KEY=your_openai_api_key_here
GITHUB_TOKEN=your_github_models_token_here
GITHUB_MODELS_BASE_URL=https://models.github.ai/inference
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
MODEL_PROVIDER=ollama
FINNHUB_API_KEY=your_finnhub_api_key_here
MARKET_DATA_PROVIDER=finnhub

# MCP settings (used only when MARKET_DATA_PROVIDER=mcp)
MCP_SERVER_URL=
MCP_AUTH_TOKEN=
MCP_TOOL_STOCK_SNAPSHOT=get_stock_snapshot
MCP_TOOL_SYMBOL_SEARCH=search_symbols
MCP_REQUEST_TIMEOUT_MS=8000

LLM_MODEL=llama3.1:8b
DEFAULT_SYMBOL=AAPL

# Supported values for MODEL_PROVIDER:
# openai
# github-models
# ollama
# If you are using GitHub Models, keep GITHUB_TOKEN set and use a model name like openai/gpt-4o-mini.
# If you are using Ollama, keep OLLAMA_BASE_URL at http://localhost:11434/v1 and set a local model like llama3.1:8b.